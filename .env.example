# Sao chép thành .env và đổi giá trị. Không commit file .env.
LVDA_OWNER_DSN=postgresql://lvda:lvda@localhost:5460/lvda
LVDA_READER_DSN=postgresql://lvda_reader:lvda_reader@localhost:5460/lvda
LVDA_JWT_SECRET=change-me-to-a-long-random-string
LVDA_JWT_TTL_HOURS=72
LVDA_WEB_ORIGIN=http://localhost:5179

# Nguồn ngoài + đồng bộ tăng dần
# Khóa Fernet mã hóa chuỗi kết nối nguồn. Tạo: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Đổi khóa thì các nguồn đã lưu phải kết nối lại. Để trống: suy ra từ LVDA_JWT_SECRET (chỉ dùng khi dev).
LVDA_SECRET_KEY=
# 0 = tắt luồng chạy theo lịch (khi chạy nhiều worker, chỉ bật ở một tiến trình)
LVDA_SCHEDULER=1
# Nút "Dùng nguồn mẫu" trên màn Kết nối: "nhãn|postgres|dsn;nhãn|mysql|dsn"
LVDA_DEMO_SOURCES=Postgres mẫu · shop|postgres|postgresql://lvda_ro:lvda_ro@localhost:5461/shop;MySQL mẫu · shop|mysql|mysql://lvda_ro:lvda_ro@localhost:3307/shop

# LLM (MVP chỉ hỗ trợ mock; openrouter/ollama là bước tiếp theo)
LVDA_LLM_PROVIDER=mock
LVDA_LLM_MODEL=mock-rules-v1
LVDA_LLM_BASE_URL=
# OPENROUTER_API_KEY=

# MCP qua HTTP
LVDA_MCP_HOST=127.0.0.1
LVDA_MCP_PORT=8021
